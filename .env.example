# true  = /chat ตอบจาก contract/chat-response.json (ไม่ต้องมี LLM) ใช้ตอนเริ่ม workshop
# false = /chat เรียก run_agent() ใน backend/app/agent.py
MOCK_MODE=true

# LLM แบบ OpenAI-compatible (เช่น vLLM) ถ้ารันบนเครื่องตัวเองให้ใช้ host.docker.internal แทน localhost
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=

# Embedding สำหรับ ingest และ retrieval (เว้นว่าง BASE_URL/API_KEY = ใช้ค่าเดียวกับ LLM)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

QDRANT_COLLECTION=docs
CORS_ORIGINS=http://localhost:3000
